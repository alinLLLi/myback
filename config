[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[branch "main"]
	vscode-merge-base = origin/main
	vscode-merge-base = back/main
[branch "my-back"]
	vscode-merge-base = back/main
	vscode-merge-base = my-back/main
	remote = origin
	merge = refs/heads/my-back
	vscode-merge-base = origin/my-back
[remote "origin"]
	url = https://github.com/alinLLLi/myback.git
	fetch = +refs/heads/*:refs/remotes/origin/*
